// Cloudflare: the built app (dist) served by a small Worker from Workers KV (worker/site.js, docs/decisions.md,
// 2026-11-02). The scan reader runs here with its own OpenRouter key, a Worker secret the user set, whose workspace budget
// caps what anyone with the link can spend. Ирц runs here behind its code (Worker secrets TIMELY_API_KEYS and
// ATTENDANCE_CODE, docs/decisions.md, 2026-11-04). Deploy: npm run deploy (Wrangler, with its usage statistics turned off).
{
  "name": "gobi-erp",
  "main": "worker/site.js",
  "compatibility_date": "2026-10-01",
  "site": { "bucket": "./dist" },
  // gobi-erp.gobiresource.workers.dev only: no extra public address for each version
  "workers_dev": true,
  "preview_urls": false
}
